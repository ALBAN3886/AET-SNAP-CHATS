rules_version='2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth(){return request.auth!=null}
    function isMine(uid){return isAuth()&&request.auth.uid==uid}
    function isAdult(){return request.resource.data.birthdate is timestamp && (request.time.toMillis()-request.resource.data.birthdate.toMillis())>=568036800000}
    function isAdmin(){return isAuth()&&request.auth.token.admin==true}
    match /users/{uid}{
      allow read:if isAuth()
      allow create:if isAdult()&&isMine(uid)
      allow update:if isMine(uid)||isAdmin()
      allow delete:if isAdmin()
      match /photos/{p}{allow read:if isAuth(); allow write,delete:if isMine(uid)||isAdmin()}
      match /preferences/{p}{allow read,write:if isMine(uid)}
    }
    match /likes/{likeId}{
      allow create,delete:if false
      allow read:if isAuth()&&(resource.data.from==request.auth.uid||resource.data.to==request.auth.uid)
    }
    match /blocks/{blockId}{
      allow create:if isAuth()&&request.resource.data.from==request.auth.uid
      allow read:if isAuth()&&(resource.data.from==request.auth.uid||resource.data.to==request.auth.uid)
      allow delete:if isAuth()&&resource.data.from==request.auth.uid
    }
    match /matches/{m}{
      allow read:if isAuth()&&request.auth.uid in resource.data.userIds
      allow create:if false
      allow update:if isAuth()&&request.auth.uid in resource.data.userIds
      allow delete:if isAuth()&&request.auth.uid in resource.data.userIds
      match /messages/{x}{
        allow read:if isAuth()&&request.auth.uid in get(/databases/$(database)/documents/matches/$(m)).data.userIds
        allow create:if false}
    }
    match /notifications/{userId}/items/{n}{
      allow read:if isAuth()&&request.auth.uid==userId
      allow create:if isAuth()
      allow update,delete:if isAuth()&&request.auth.uid==userId}
    match /news/{a}{
      allow read:if true
      allow create:if isAuth()&&request.resource.data.authorId==request.auth.uid&&request.resource.data.status=='pending'
      allow update,delete:if isAdmin()}
    match /jobs/{j}{
      allow read:if true
      allow create:if isAuth()&&request.resource.data.publisherId==request.auth.uid
      allow update,delete:if isAuth()&&(resource.data.publisherId==request.auth.uid||isAdmin())
      match /applications/{a}{
        allow create:if isAuth()&&request.resource.data.applicantId==request.auth.uid
        allow read:if isAuth()&&(resource.data.applicantId==request.auth.uid||isAdmin())}}
    match /jobSeekers/{s}{
      allow read:if true
      allow create:if isAuth()&&request.resource.data.uid==request.auth.uid
      allow update,delete:if isAuth()&&(resource.data.uid==request.auth.uid||isAdmin())}
    match /reports/{r}{
      allow create:if isAuth()&&request.resource.data.reporterId==request.auth.uid
      allow read,update,delete:if isAdmin()}
    match /audit/{d}{allow read,write:if isAdmin()}
  }
}
