rules_version='2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuth(){return request.auth!=null}
    match /users/{uid}/photos/{f}{allow read:if isAuth(); allow write,delete:if isAuth()&&request.auth.uid==uid&&request.resource.size<5*1024*1024&&request.resource.contentType.matches('image/.*')}
    match /users/{uid}/cvs/{f}{allow read,write:if isAuth()&&request.auth.uid==uid&&request.resource.size<8*1024*1024&&request.resource.contentType=='application/pdf'}
    match /jobs/{j}/logo/{f}{allow read:if true; allow write:if request.resource.size<2*1024*1024&&request.resource.contentType.matches('image/.*')}
    match /news/{f}{allow read:if true}
  }
}
